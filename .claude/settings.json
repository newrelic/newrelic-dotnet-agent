{
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(dotnet *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(xsd2code *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git release *)",
      "Bash(git tag *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)"
    ]
  },
    "enabledPlugins": {
        "nr@claude-plugin-marketplace": true,
        "superpowers@claude-plugins-official": true,
        "claude-md-management@claude-plugins-official": true,
        "code-review@claude-plugins-official": true,
        "document-skills@claude-plugins-official": true,
        "skill-creator@claude-plugins-official": true
    },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codegraph-gate.py\" pre" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*codegraph.*|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codegraph-gate.py\" post" }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*codegraph.*|Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codegraph-gate.py\" post" }
        ]
      }
    ]
  }
}
