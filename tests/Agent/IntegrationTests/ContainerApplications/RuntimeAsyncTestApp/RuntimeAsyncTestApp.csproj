<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>
  <!-- Runtime-async is on by default on net11.0. On net10.0 it is a preview feature that needs
       this opt-in, plus DOTNET_RuntimeAsync=1 at run time (the Dockerfile sets it). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Features>runtime-async=on</Features>
    <!-- Both are emitted as errors, and Directory.Build.props sets TreatWarningsAsErrors.
         SYSLIB5007: the lowering targets System.Runtime.CompilerServices.AsyncHelpers, which
         is [Experimental] on net10.0. CA2252: using a preview feature.
         EnablePreviewFeatures does NOT suppress either one - these NoWarns are load-bearing. -->
    <NoWarn>$(NoWarn);SYSLIB5007;CA2252</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NewRelic.Agent.Api" Version="10.54.0" />
  </ItemGroup>
</Project>
