# Exclude transient / large / generated content from image build contexts.

# Emulator state and other transient directories
volume/

# Node modules (if any JS tooling leaks in)
**/node_modules/

# Dotnet build outputs
**/bin/
**/obj/
**/TestResults/

# Logs, temp artifacts
**/logs/
**/*.log

# Git & tooling
.git/
.gitignore
.dockerignore
