<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Added for OTLP protobuf deserialization -->
    <PackageReference Include="Google.Protobuf" Version="3.26.1" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\opentelemetry\proto\collector\metrics\v1\metrics_service.proto" ProtoRoot="Protos" GrpcServices="None" />
    <Protobuf Include="Protos\opentelemetry\proto\metrics\v1\metrics.proto" ProtoRoot="Protos" GrpcServices="None" />
    <Protobuf Include="Protos\opentelemetry\proto\common\v1\common.proto" ProtoRoot="Protos" GrpcServices="None" />
    <Protobuf Include="Protos\opentelemetry\proto\resource\v1\resource.proto" ProtoRoot="Protos" GrpcServices="None" />
  </ItemGroup>

  <!-- Reuse the agent's vendored OTLP profiles protos directly (no second copy) so the mock collector
       parses the exact ExportProfilesServiceRequest the production OtlpProfileBuilder emits. These carry
       csharp_namespace OpenTelemetry.Proto.* (capital T), distinct from the mock's metrics protos above. -->
  <PropertyGroup>
    <ProfilesProtoRoot>..\..\..\..\..\src\Agent\NewRelic\Agent\Core\ContinuousProfiling\Otlp</ProfilesProtoRoot>
  </PropertyGroup>
  <ItemGroup>
    <Protobuf Include="$(ProfilesProtoRoot)\common.proto" ProtoRoot="$(ProfilesProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ProfilesProtoRoot)\resource.proto" ProtoRoot="$(ProfilesProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ProfilesProtoRoot)\profiles.proto" ProtoRoot="$(ProfilesProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ProfilesProtoRoot)\profiles_service.proto" ProtoRoot="$(ProfilesProtoRoot)" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <DotNetCliToolReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Tools" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ApplicationHelperLibraries\ApplicationLifecycle\ApplicationLifecycle.csproj" />
    <ProjectReference Include="..\..\Models\Models.csproj" />
  </ItemGroup>

</Project>
