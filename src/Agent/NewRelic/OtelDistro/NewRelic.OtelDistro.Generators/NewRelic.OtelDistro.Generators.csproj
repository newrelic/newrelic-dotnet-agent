<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>NewRelic.OtelDistro.Generators</AssemblyName>
    <RootNamespace>NewRelic.OtelDistro.Generators</RootNamespace>
    <Description>Roslyn incremental source generator that turns New Relic instrumentation XML into OTel CallTarget integrations (S4 prototype).</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one definition of the NRIDT table format, owned by Core (whose reader uses it). Linked rather than referenced:
         an analyzer cannot reference Core. It is internal, so it does not clash with Core's copy where both are visible. -->
    <Compile Include="..\..\Agent\Core\OtelDistro\InstrumentationDefinitionsTableFormat.cs" Link="InstrumentationDefinitionsTableFormat.cs" />
  </ItemGroup>

</Project>
