<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared MSBuild properties for the native profiler solution.

  NativeToolset defaults to v145 (VS 2025 / windows-2025-vs2026 CI runner).
  To build with a different toolset without editing project files, pass
  /p:NativeToolset=vNNN on the MSBuild command line or set the property
  in a CI workflow before invoking MSBuild.
-->
<Project>
  <PropertyGroup>
    <NativeToolset Condition="'$(NativeToolset)'==''">v145</NativeToolset>
  </PropertyGroup>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- This subtree does not chain to the root Directory.Build.props, so enable code-style
         analyzers explicitly here to keep IDE0073 copyright-header enforcement active at build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Pin the C++ language standard explicitly so Windows doesn't silently
       drift from the toolset default. This matches the Linux musl build
       (CMakeLists.txt) but NOT the Linux glibc build, which is intentionally
       held at C++11 for a libc++/xplat.h shim conflict. See the comment
       above the glibc CMAKE_CXX_FLAGS in CMakeLists.txt before changing
       either side. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp14</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
